// This is your Prisma schema file,
// learn more about it in the docs at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique(map: "User_email_key")
  password  String
  name      String
  phone     String?
  role      Role     @default(BUYER)
  verified  Boolean  @default(false)
  isActive  Boolean  @default(true)
  emailVerified Boolean @default(false)

  // Profile photo, moderated like listings: uploads go PENDING until an admin
  // approves or rejects them. `avatar` uses the same storage format as
  // VehicleImage.data (/uploads path, S3 URL or base64 data URI).
  avatar                String?       
  avatarStatus          AvatarStatus  @default(NONE)
  avatarRejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile?
  favorites     Favorite[]
  reviewsGiven  Review[]       @relation("ReviewAuthor")
  messagesSent  Message[]      @relation("MessageSender")
  messagesReceived Message[]   @relation("MessageReceiver")
  reports       Report[]       @relation("ReportReporter")
  payments      Payment[]
  subscription  Subscription?
  authTokens    AuthToken[]
  notifications Notification[]

  @@map("user")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // NEW_MESSAGE, LISTING_APPROVED, LISTING_REJECTED, ...
  title     String
  body      String?
  data      Json?    // e.g. { senderId, vehicleId, vehicleTitle }
  senderId  Int?     // routing columns for NEW_MESSAGE: lets clients clear the
  vehicleId Int?     // badge for one conversation (read-all?senderId=&vehicleId=)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, type, senderId, vehicleId])
  @@map("notification")
}

model AuthToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("authtoken")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// Moderation state of a user's profile photo.
enum AvatarStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model SellerProfile {
  id         Int        @id @default(autoincrement())
  userId     Int        @unique(map: "SellerProfile_userId_key")
  user       User       @relation(fields: [userId], references: [id])
  whatsapp   String?
  location   String?
  sellerType SellerType @default(PRIVATE)
  verified   Boolean    @default(false)
  rating     Float      @default(0.0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  vehicles Vehicle[]
  reviews  Review[]  @relation("SellerReviews")

  @@map("sellerprofile")
}

enum SellerType {
  PRIVATE
  DEALER
  COMPANY
}

model Vehicle {
  id           Int      @id @default(autoincrement())
  sellerId     Int
  seller       SellerProfile @relation(fields: [sellerId], references: [id])
  make         String
  model        String
  year         Int
  price        Float
  location     String
  condition    Condition @default(FOREIGN_USED)

  // Specifications
  mileage      Int?
  transmission Transmission @default(AUTOMATIC)
  fuelType     FuelType     @default(PETROL)
  engineSize   String?
  driveType    String?
  bodyType     String?
  color        String?
  doors        Int?
  seats        Int?

  description  String?
  status       VehicleStatus @default(PENDING)
  featured     Boolean       @default(false)
  featuredUntil DateTime?
  expiresAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images       VehicleImage[]
  features     VehicleFeature[]
  documents    VehicleDocument[]
  favorites    Favorite[]
  messages     Message[]
  reports      Report[]
  payments     Payment[]

  @@index([sellerId])
  // Hot-path composite indexes for search/home queries
  @@index([status, createdAt])
  @@index([status, price])
  @@index([make, model])
  @@index([featured, status])
  @@map("vehicle")
}

enum Condition {
  BRAND_NEW
  FOREIGN_USED
  LOCALLY_USED
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleStatus {
  PENDING
  AVAILABLE
  REJECTED
  SOLD
  DEACTIVATED // taken down by an admin; recoverable via the admin listings screen
  REMOVED // soft-closed by the seller; chats about the car are kept
}

model VehicleImage {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  data      String
  isPrimary Boolean  @default(false)

  @@index([vehicleId])
  @@map("vehicleimage")
}

model VehicleFeature {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  featureName String

  @@index([vehicleId])
  @@map("vehiclefeature")
}

model VehicleDocument {
  id           Int      @id @default(autoincrement())
  vehicleId    Int
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  documentType String
  data         String

  @@index([vehicleId])
  @@map("vehicledocument")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([vehicleId])
  @@map("favorite")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  vehicleId  Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
  @@index([vehicleId])
  @@index([vehicleId, createdAt])
  @@map("message")
}

model Review {
  id        Int           @id @default(autoincrement())
  authorId  Int
  author    User          @relation("ReviewAuthor", fields: [authorId], references: [id])
  sellerId  Int
  seller    SellerProfile @relation("SellerReviews", fields: [sellerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())

  @@index([authorId])
  @@index([sellerId])
  @@map("review")
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  vehicleId  Int?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([reporterId])
  @@index([vehicleId])
  @@map("report")
}

enum PaymentPlan {
  BASIC
  PLUS
  DEALER_BASIC
  DEALER_PRO
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Payment {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  plan        PaymentPlan
  amount      Int // integer pesewas (GHS * 100) — never floats for money
  reference   String        @unique
  status      PaymentStatus @default(PENDING)
  method      String        @default("PAYSTACK")
  channel     String?
  paidAt      DateTime?
  vehicleId   Int?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payment")
}

model Subscription {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  user        User        @relation(fields: [userId], references: [id])
  plan        PaymentPlan
  status      String      @default("ACTIVE")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("subscription")
}

// Moderation trail: every admin action and seller listing mutation lands here.
// actorId is deliberately a plain column (no FK) so deleting a user never
// breaks old entries; actorName/actorRole are denormalised for the same reason.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorRole  String?
  actorName  String?
  action     String // LISTING.APPROVE, USER.DEACTIVATE, PAYMENT.VERIFY, ...
  entityType String // VEHICLE | USER | PAYMENT | REPORT
  entityId   Int?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("auditlog")
}

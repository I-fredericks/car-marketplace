// This is your Prisma schema file,
// learn more about it in the docs at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique(map: "User_email_key")
  password  String
  name      String
  phone     String?
  role      Role     @default(BUYER)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile?
  favorites     Favorite[]
  reviewsGiven  Review[]       @relation("ReviewAuthor")
  messagesSent  Message[]      @relation("MessageSender")
  messagesReceived Message[]   @relation("MessageReceiver")
  reports       Report[]       @relation("ReportReporter")
  payments      Payment[]
  subscription  Subscription?

  @@map("user")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model SellerProfile {
  id         Int        @id @default(autoincrement())
  userId     Int        @unique(map: "SellerProfile_userId_key")
  user       User       @relation(fields: [userId], references: [id])
  whatsapp   String?
  location   String?
  sellerType SellerType @default(PRIVATE)
  verified   Boolean    @default(false)
  rating     Float      @default(0.0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  vehicles Vehicle[]
  reviews  Review[]  @relation("SellerReviews")

  @@map("sellerprofile")
}

enum SellerType {
  PRIVATE
  DEALER
  COMPANY
}

model Vehicle {
  id           Int      @id @default(autoincrement())
  sellerId     Int
  seller       SellerProfile @relation(fields: [sellerId], references: [id])
  make         String
  model        String
  year         Int
  price        Float
  location     String
  condition    Condition @default(FOREIGN_USED)

  // Specifications
  mileage      Int?
  transmission Transmission @default(AUTOMATIC)
  fuelType     FuelType     @default(PETROL)
  engineSize   String?
  driveType    String?
  bodyType     String?
  color        String?
  doors        Int?
  seats        Int?

  description  String? @db.Text
  status       VehicleStatus @default(PENDING)
  featured     Boolean       @default(false)
  featuredUntil DateTime?
  expiresAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images       VehicleImage[]
  features     VehicleFeature[]
  documents    VehicleDocument[]
  favorites    Favorite[]
  messages     Message[]
  reports      Report[]
  payments     Payment[]

  @@index([sellerId])
  @@map("vehicle")
}

enum Condition {
  BRAND_NEW
  FOREIGN_USED
  LOCALLY_USED
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleStatus {
  PENDING
  AVAILABLE
  REJECTED
  SOLD
}

model VehicleImage {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  data      String   @db.MediumText
  isPrimary Boolean  @default(false)

  @@index([vehicleId])
  @@map("vehicleimage")
}

model VehicleFeature {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  featureName String

  @@index([vehicleId])
  @@map("vehiclefeature")
}

model VehicleDocument {
  id           Int      @id @default(autoincrement())
  vehicleId    Int
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  documentType String
  data         String   @db.MediumText

  @@index([vehicleId])
  @@map("vehicledocument")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([vehicleId])
  @@map("favorite")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  vehicleId  Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
  @@index([vehicleId])
  @@map("message")
}

model Review {
  id        Int           @id @default(autoincrement())
  authorId  Int
  author    User          @relation("ReviewAuthor", fields: [authorId], references: [id])
  sellerId  Int
  seller    SellerProfile @relation("SellerReviews", fields: [sellerId], references: [id])
  rating    Int
  comment   String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([authorId])
  @@index([sellerId])
  @@map("review")
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  vehicleId  Int?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([reporterId])
  @@index([vehicleId])
  @@map("report")
}

enum PaymentPlan {
  BASIC
  PLUS
  DEALER_BASIC
  DEALER_PRO
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Payment {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  plan        PaymentPlan
  amount      Float
  reference   String        @unique
  status      PaymentStatus @default(PENDING)
  method      String        @default("PAYSTACK")
  channel     String?
  paidAt      DateTime?
  vehicleId   Int?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payment")
}

model Subscription {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  user        User        @relation(fields: [userId], references: [id])
  plan        PaymentPlan
  status      String      @default("ACTIVE")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("subscription")
}

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL — Supabase in production)
# Local dev: postgresql://postgres:postgres@localhost:5432/carmarketplace
# Supabase runtime (app): the POOLER URL, from Project Settings -> Database ->
# Connection string -> "Connection pooling"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Supabase migrations: the DIRECT URL (same page) — used only by
# `prisma migrate dev/deploy`, which needs a direct (non-pooled) connection
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=""

# Test database — NEVER commit the real URL. Set this in your local .env
# (not .env.example) to point at your Supabase carmarket_test database.
# CI provides DATABASE_URL instead (local Postgres service container).
TEST_DATABASE_URL=""

# Comma-separated list of allowed browser origins for CORS
# (localhost dev origins are always allowed in addition to these).
# In production this is your SPA origin — for Vercel, e.g. https://your-app.vercel.app
FRONTEND_URL="http://localhost:5173"

# Public origin of THIS API, as reachable from the internet. Verification &
# password-reset email links are built on it. Set it in production — e.g.
# https://car-marketplace-api.onrender.com . If left unset, links are derived
# from the incoming request's host (works behind a properly proxied deploy,
# but the explicit value is safer for scheduled/background sends).
# PUBLIC_API_URL="https://your-api-domain.com"

# Paystack (test keys — replace with live keys in production)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Where Paystack redirects the user after checkout (frontend route).
# Leave empty to auto-derive from the incoming request host.
PAYSTACK_CALLBACK_URL=""
# Full URL to set in the Paystack dashboard → Settings → Webhooks:
# e.g. https://<your-domain>/api/billing/webhook

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=""

# External image hosts the /api/images redirect may send users to (comma-separated)
EXTERNAL_IMAGE_HOSTS="images.unsplash.com,res.cloudinary.com"

# Optional Redis cache for hot public reads (listing searches).
# Leave empty to run without any caching (dev/CI default).
# e.g. redis://localhost:6379 or rediss://... for hosted Redis (Upstash etc.)
REDIS_URL=""

# Optional S3-compatible image storage. When all five bucket/credential vars
# are set, new uploads go to object storage (originals + WebP thumbnails,
# served directly from S3_PUBLIC_URL). Leave empty to store files on disk
# under backend/uploads. Works with AWS S3, Cloudflare R2, DigitalOcean
# Spaces, MinIO — point S3_ENDPOINT at the provider and S3_PUBLIC_URL at the
# public bucket/CDN URL.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Email (SMTP) — when empty, verification/reset links are logged to the server console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Seeding (production only): refuse to run without SEED_PASSWORD
# SEED_PASSWORD=""
# ADMIN_PASSWORD=""

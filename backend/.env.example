# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/car_marketplace"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=""

# Comma-separated list of allowed browser origins for CORS
# (localhost dev origins are always allowed in addition to these)
FRONTEND_URL="http://localhost:5173"

# Paystack (test keys — replace with live keys in production)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Where Paystack redirects the user after checkout (frontend route).
# Leave empty to auto-derive from the incoming request host.
PAYSTACK_CALLBACK_URL=""
# Full URL to set in the Paystack dashboard → Settings → Webhooks:
# e.g. https://<your-domain>/api/billing/webhook

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=""

# External image hosts the /api/images redirect may send users to (comma-separated)
EXTERNAL_IMAGE_HOSTS="images.unsplash.com,res.cloudinary.com"

# Optional Redis cache for hot public reads (listing searches).
# Leave empty to run without any caching (dev/CI default).
# e.g. redis://localhost:6379 or rediss://... for hosted Redis (Upstash etc.)
REDIS_URL=""

# Optional S3-compatible image storage. When all five bucket/credential vars
# are set, new uploads go to object storage (originals + WebP thumbnails,
# served directly from S3_PUBLIC_URL). Leave empty to store files on disk
# under backend/uploads. Works with AWS S3, Cloudflare R2, DigitalOcean
# Spaces, MinIO — point S3_ENDPOINT at the provider and S3_PUBLIC_URL at the
# public bucket/CDN URL.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Email (SMTP) — when empty, verification/reset links are logged to the server console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Seeding (production only): refuse to run without SEED_PASSWORD
# SEED_PASSWORD=""
# ADMIN_PASSWORD=""
